# Postgres connection string (Neon, Supabase, Vercel Postgres, local...)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random string used to sign the admin login cookie (16+ characters)
JWT_SECRET=change-this-to-a-long-random-string

# --- Admin login: use Google, a password, or both ---
# Google sign-in (only this Gmail address is allowed in)
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=nikimohan12@gmail.com
# Password login (optional if Google is set up)
ADMIN_PASSWORD=change-this-to-something-long

# Optional: your time zone in minutes from UTC, used for "today" in analytics (India = 330)
TZ_OFFSET_MIN=330
